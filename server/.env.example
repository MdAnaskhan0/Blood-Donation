PORT=5000
CLIENT_URL=http://localhost:5173

# Laragon MySQL defaults (root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blood_donation

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP (use Gmail app password, Mailtrap, Brevo, etc.)
# Leave SMTP_HOST empty in development to just print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blood Donation <no-reply@blooddonation.local>"
